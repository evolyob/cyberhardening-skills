{
  "system-survival-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/system_survival_guard.py",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "pre-write-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/pre_write_guard.py",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "view-file-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/view_file_safety.py",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "post-tool-quality-guard": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/post_tool_quality_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
